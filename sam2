import os
import torch
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
from pathlib import Path
from sam2.build_sam import build_sam2
from sam2.automatic_mask_generator import SAM2AutomaticMaskGenerator

# Paths
IMAGE_DIR = "/content/drive/MyDrive/ethiopian_crop_images"
OUTPUT_DIR = "/content/sam2_results"
CHECKPOINT = "/content/sam2.1_hiera_small.pt"
CONFIG = "configs/sam2.1/sam2.1_hiera_s.yaml"

# Check inputs
if not os.path.isdir(IMAGE_DIR):
    raise FileNotFoundError(f"Image folder not found: {IMAGE_DIR}")

if not os.path.isfile(CHECKPOINT):
    raise FileNotFoundError(f"SAM 2 checkpoint not found: {CHECKPOINT}")

os.makedirs(OUTPUT_DIR, exist_ok=True)

# Choose device
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
print("Device:", DEVICE)

# Load model
sam2_model = build_sam2(CONFIG, CHECKPOINT, device=DEVICE)

mask_generator = SAM2AutomaticMaskGenerator(
    model=sam2_model,
    points_per_side=24,
    pred_iou_thresh=0.7,
    stability_score_thresh=0.85,
    min_mask_region_area=200,
)

print("SAM 2 loaded successfully!")

import os

CHECKPOINT = "/content/sam2.1_hiera_small.pt"

if not os.path.exists(CHECKPOINT):
    !wget -O /content/sam2.1_hiera_small.pt \
    https://dl.fbaipublicfiles.com/segment_anything_2/092824/sam2.1_hiera_small.pt

print("Checkpoint exists:", os.path.isfile(CHECKPOINT))
print("Checkpoint size:", round(os.path.getsize(CHECKPOINT) / (1024**2), 2), "MB")



import gc
import shutil

# Find supported images
extensions = {".jpg", ".jpeg", ".png", ".bmp", ".webp"}

image_paths = sorted([
    p for p in Path(IMAGE_DIR).iterdir()
    if p.is_file() and p.suffix.lower() in extensions
])

print(f"Found {len(image_paths)} images.")

if not image_paths:
    raise ValueError(f"No supported images found in {IMAGE_DIR}")

# Recreate output folder for this run
os.makedirs(OUTPUT_DIR, exist_ok=True)

for image_path in image_paths:
    print(f"\nProcessing: {image_path.name}")

    # Load RGB image
    image = np.array(Image.open(image_path).convert("RGB"))

    # Generate masks
    with torch.inference_mode():
        if DEVICE == "cuda":
            with torch.autocast("cuda", dtype=torch.float16):
                masks = mask_generator.generate(image)
        else:
            masks = mask_generator.generate(image)

    # Create output folder
    image_output = Path(OUTPUT_DIR) / image_path.stem
    image_output.mkdir(parents=True, exist_ok=True)

    # Save original image
    Image.fromarray(image).save(image_output / "original.png")

    # Overlay all detected masks
    overlay = image.copy()
    rng = np.random.default_rng(42)

    for item in masks:
        mask = item["segmentation"]
        color = rng.integers(50, 256, size=3, dtype=np.uint8)
        overlay[mask] = (
            0.5 * overlay[mask] + 0.5 * color
        ).astype(np.uint8)

    # Sort masks by area, largest first
    masks = sorted(masks, key=lambda item: item["area"], reverse=True)

    # Use the largest region as an example candidate.
    # IMPORTANT: this may be a leaf, part of a leaf, or background.
    if masks:
        best_mask = masks[0]["segmentation"]

        binary_mask = (best_mask * 255).astype(np.uint8)

        isolated = np.zeros_like(image)
        isolated[best_mask] = image[best_mask]

        Image.fromarray(binary_mask).save(
            image_output / "largest_candidate_mask.png"
        )
        Image.fromarray(isolated).save(
            image_output / "largest_candidate_isolated.png"
        )
        Image.fromarray(overlay).save(
            image_output / "all_masks_overlay.png"
        )

        # Display 4 panels side by side in Colab
        fig, axes = plt.subplots(1, 4, figsize=(22, 6))

        axes[0].imshow(image)
        axes[0].set_title("1. Original Image")

        axes[1].imshow(overlay)
        axes[1].set_title(f"2. All Masks ({len(masks)})")

        axes[2].imshow(isolated)
        axes[2].set_title("3. Largest Candidate")

        axes[3].imshow(binary_mask, cmap="gray", vmin=0, vmax=255)
        axes[3].set_title("4. Binary Mask")

        for ax in axes:
            ax.axis("off")

        fig.suptitle(image_path.name, fontsize=14)
        plt.tight_layout()
        plt.show()
        plt.close(fig)

        print("Masks detected:", len(masks))
        print("Saved to:", image_output)

    else:
        print("No masks detected for this image.")

    del image, masks
    gc.collect()
    if DEVICE == "cuda":
        torch.cuda.empty_cache()

print("\nAll images processed.")
print("Output directory:", OUTPUT_DIR)

